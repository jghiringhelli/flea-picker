# Flea Picker — environment variable template
# Copy to .env.local for local overrides. All VITE_ vars are exposed to the bundle.

NODE_ENV=development
LOG_LEVEL=info

# Feature flags
VITE_ENABLE_DEBUG_OVERLAY=false
VITE_ENABLE_FPS_COUNTER=false

# Set when hosting under a subpath (e.g. GitHub Pages project repo)
# VITE_BASE_URL=/flea-picker
